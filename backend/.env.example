# Copie para .env e ajuste os valores
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:dev@localhost:5433/portal
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# true somente quando servido por HTTPS
COOKIE_SECURE=false
# true somente atrás de um proxy reverso confiável (ex.: nginx do docker-compose)
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173
