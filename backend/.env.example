# Copie para .env e ajuste os valores
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portal
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# true somente quando servido por HTTPS
COOKIE_SECURE=false
# Em NODE_ENV=production a API RECUSA os segredos de demonstração publicados no repositório (como o JWT_SECRET acima),
# a menos que esta variável seja 'true' (o docker-compose de demonstração a liga). Em produção real: segredo próprio e false.
PERMITIR_SEGREDOS_DE_DEMONSTRACAO=false
# true somente atrás de um proxy reverso confiável (ex.: nginx do docker-compose)
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173
