# Copie para .env para personalizar o docker-compose. Todos os valores têm padrão de demonstração.

# Porta da interface no seu computador (a API só é alcançável por ela, em /api)
FRONTEND_PORT=8080

# Banco de dados (usuário "portal", banco "portal"). Evite caracteres especiais na senha (ela entra numa URL).
POSTGRES_PASSWORD=portal_demo_password

# Assinatura dos tokens de sessão: use um valor longo e aleatório fora da demonstração
# (ex.: openssl rand -hex 32). O valor padrão é PÚBLICO (está no repositório): com ele, qualquer pessoa forja uma sessão.
JWT_SECRET=segredo-de-demonstracao-troque-em-producao
JWT_EXPIRES_IN=8h

# Mude para true somente se servir o sistema por HTTPS (o cookie de sessão passa a exigir conexão segura)
COOKIE_SECURE=false

# O compose de demonstração autoriza o segredo público acima (a API mostra um aviso no log). Ao publicar de verdade:
# defina JWT_SECRET próprio e coloque false aqui, ou a API se recusa a iniciar em produção com o segredo de demonstração.
PERMITIR_SEGREDOS_DE_DEMONSTRACAO=true
