# Copie para .env para personalizar o docker-compose. Todos os valores têm padrão de demonstração.

# Portas expostas no seu computador
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Banco de dados (usuário "portal", banco "portal"). Evite caracteres especiais na senha (ela entra numa URL).
POSTGRES_PASSWORD=portal_demo_password

# Assinatura dos tokens de sessão: use um valor longo e aleatório fora da demonstração
# (ex.: openssl rand -hex 32)
JWT_SECRET=segredo-de-demonstracao-troque-em-producao
JWT_EXPIRES_IN=8h

# Mude para true somente se servir o sistema por HTTPS (o cookie de sessão passa a exigir conexão segura)
COOKIE_SECURE=false
